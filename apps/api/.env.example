DATABASE_URL="postgresql://postgres:password@localhost:5432/ims?schema=public"

# The frontend has no silent-refresh flow (a 401 logs the user straight out
# rather than calling /auth/refresh), so this is the actual session length a
# logged-in user gets — keep it at a full shift or more.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
WEB_ORIGIN="http://localhost:3000"
